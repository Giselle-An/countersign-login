# Set these in your shell or hosting platform. No third-party API keys are required.
PORT=3000
HOST=127.0.0.1
# Public HTTPS URL when deploying, e.g. https://login.example.com
# APP_ORIGIN=https://login.example.com
# Set true behind an HTTPS reverse proxy; false for local HTTP.
SECURE_COOKIES=false
# Optional persistent private storage directory (outside publicly served files).
# DATA_DIR=./data
